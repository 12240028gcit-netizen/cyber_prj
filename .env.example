PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_NAME=Club Administrator
# Set both paths to enable HTTPS directly in Node. In production, terminate TLS at a trusted reverse proxy.
TLS_KEY_PATH=
TLS_CERT_PATH=
# Set to 1 only when behind a trusted reverse proxy that sets forwarded headers.
TRUST_PROXY=0
